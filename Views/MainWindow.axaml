<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HereticalEngineEditor.Views"
        xmlns:vm="clr-namespace:HereticalEngineEditor.ViewModels"
        x:Class="HereticalEngineEditor.Views.MainWindow"
		x:DataType="vm:MainViewModel"
        Width="800" Height="500"
        Title="Heretical Engine"
        CanResize="False">

	<ContentControl Content="{Binding CurrentViewModel}" />
</Window>
