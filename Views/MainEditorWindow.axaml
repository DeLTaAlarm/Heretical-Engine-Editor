<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:HereticalEngineEditor.ViewModels"
		xmlns:ia="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
		xmlns:core="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
        mc:Ignorable="d"
        x:Class="HereticalEngineEditor.Views.MainEditorWindow"
        x:DataType="vm:MainEditorViewModel"
        Width="1280" Height="720"
        Title="{Binding EditorTitle}">

	<Window.Styles>
		<Style Selector="Button.parallelogram">
			<Setter Property="Template">
				<ControlTemplate>
					<Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
						<Path Stretch="Fill"
                              Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="{TemplateBinding BorderThickness}"
                              Data="M 0 0 L 90 0 L 100 40 L 10 40 Z" />
						<ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
					</Grid>
				</ControlTemplate>
			</Setter>
			<Setter Property="Background" Value="#FF3A3A3A"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="12,6"/>
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Width" Value="100"/>
			<Setter Property="Height" Value="40"/>
		</Style>

		<Style Selector="Border.file-item">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="4" />
		</Style>

		<Style Selector="Border.file-item:hover">
			<Setter Property="Background" Value="{DynamicResource ThemeSecondaryBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBorderBrush}" />
		</Style>

		<Style Selector="Border.file-item:pressed">
			<Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
		</Style>
	</Window.Styles>

	<Window.Resources>
		<vm:DirToEmojiConverter x:Key="DirToEmojiConverter"/>
	</Window.Resources>

	<DockPanel>
		<StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#FF1E1E1E" Height="40" VerticalAlignment="Center" Margin="6,4">
			<Menu DockPanel.Dock="Top" Background="#FF1E1E1E" FontWeight="Light">
				<MenuItem Header="Файл">
					<MenuItem Header="Новый проект" Command="{Binding FileNewCommand}"/>
					<MenuItem Header="Открыть проект" Command="{Binding FileOpenCommand}"/>
				</MenuItem>
				<MenuItem Header="Редактирование">
					<MenuItem Header="Отменить" Command="{Binding EditUndoCommand}"/>
					<MenuItem Header="Повторить" Command="{Binding EditRedoCommand}"/>
				</MenuItem>
				<MenuItem Header="Проект">
					<MenuItem Header="Параметры" Command="{Binding ProjectSettingsCommand}"/>
					<MenuItem Header="Собрать проект" Command="{Binding BuildCommand}"/>
				</MenuItem>
				<MenuItem Header="Настройки" Command="{Binding SettingsCommand}"/>
				<MenuItem Header="Плагины" Command="{Binding PluginsCommand}"/>
			</Menu>
		</StackPanel>

		<DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="6" Background="#FF1E1E1E">
			
			<StackPanel Orientation="Vertical">
				<StackPanel Orientation="Horizontal" Margin="4" Spacing="4">
					<Button Width="36" Height="32" Content="📁" ToolTip.Tip="Создать" Name="CreateButton" Click="CreateButton_OnClick"/>					
					<Button Content="🔄" Command="{Binding RefreshCommand}" ToolTip.Tip="Обновить" Width="36" Height="32"/>
					<Button Content="←" Command="{Binding BackCommand}" ToolTip.Tip="Назад" Width="36" Height="32"/>
					<TextBox x:Name="ContentPathTextBox"
							 Text="{Binding ContentPath, Mode=TwoWay}"
							 Width="600"
							 Margin="8,0,0,0"
							 Background="#FF2E2E2E"
							 Foreground="White">
					
					</TextBox>
				</StackPanel>

				<Border Height="1" Background="Gray" Margin="0,4"/>

				<ScrollViewer Height="200">
					<ItemsControl ItemsSource="{Binding FileItems}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:FileItemViewModel">
								<Button Width="100" Margin="4" Classes="file-item" Click="OnItemClicked">
									<StackPanel HorizontalAlignment="Center">
										<TextBlock FontSize="32"
												   Text="{Binding IsDirectory, Converter={StaticResource DirToEmojiConverter}}"
												   HorizontalAlignment="Center" />
										<TextBlock Text="{Binding Name}"
												   TextWrapping="Wrap"
												   FontSize="12"
												   HorizontalAlignment="Center"
												   Foreground="White" />
									</StackPanel>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</StackPanel>
		</DockPanel>
	</DockPanel>
</Window>
