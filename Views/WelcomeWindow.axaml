<Window 
	    xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HereticalEngineEditor.ViewModels"
		xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Avalonia.Svg.Skia"
        mc:Ignorable="d"
        x:Class="HereticalEngineEditor.Views.WelcomeWindow"
        x:DataType="vm:WelcomeWindowViewModel"
        Width="800" Height="500"
        CanResize="False"
        Title="Heretical Engine">

	<Grid RowDefinitions="Auto,*" Margin="40">
		<TextBlock Text="Добро пожаловать!"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,40"/>

		<Grid Grid.Row="1"
              ColumnDefinitions="1*,1*"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ColumnSpacing="40">

			<Button Command="{Binding CreateCommand}"
                    Grid.Column="0"
                    Height="220"
                    CornerRadius="15"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
				<StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10">
					<TextBlock Text="➕"
                               FontSize="32"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="Создать проект"
                               FontSize="18"
                               HorizontalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Click="OnOpenProjectClick"
                    Grid.Column="1"
                    Height="220"
                    CornerRadius="15"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
				<StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10">
					<TextBlock Text="📂"
                               FontSize="32"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="Открыть проект"
                               FontSize="18"
                               HorizontalAlignment="Center"/>
				</StackPanel>
			</Button>

		</Grid>
	</Grid>
</Window>
